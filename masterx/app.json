{
  "expo": {
    "name": "Savit",
    "slug": "savit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getsavit.savit",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.getsavit.savit"
        ]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "Savit uses your photo library to set collection icons.",
        "NSCameraUsageDescription": "Savit uses the camera to set collection icons.",
        "NSPhotoLibraryAddUsageDescription": "Savit saves images for collection icons.",
        "NSClipboardUsageDescription": "Savit reads your clipboard to detect links you've copied so you can save them quickly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.getsavit.savit",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https"
            },
            {
              "scheme": "http"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIphoneOnly",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Savit uses the camera to set collection icons.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Savit uses your photo library to set collection icons."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.app.getsavit.savit",
          "iosShareExtensionBundleIdentifier": "app.getsavit.savit.share-extension",
          "disableExperimental": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10e54aa6-f208-4680-a65a-69b3e55449a8",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "app.getsavit.savit.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.getsavit.savit"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "rcconstantedev"
  }
}
